DirectoryIndex site.php index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Serve existing files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Home: serve site.php at the root
RewriteRule ^$ site.php [L]

# Event listing and detail
RewriteRule ^events/?$ events.php [L,QSA]
RewriteRule ^events/([0-9]+)(?:-[^/]+)?/?$ event.php?id=$1 [L,QSA]
RewriteRule ^basket/?$ basket.php [L,QSA]
RewriteRule ^checkout/?$ checkout.php [L,QSA]
RewriteRule ^checkout/complete/?$ checkout_complete.php [L,QSA]
RewriteRule ^account/?$ account.php [L,QSA]
RewriteRule ^bookings/?$ bookings.php [L,QSA]
RewriteRule ^orders/?$ bookings.php [L,QSA]
RewriteRule ^memberships/?$ memberships.php [L,QSA]

# Route clean page URLs: /pages/your-slug -> page.php?path=your-slug
RewriteRule ^pages/([^/]+)/?$ page.php?path=$1 [L,QSA]
</IfModule>
